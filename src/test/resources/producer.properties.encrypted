bootstrap.servers=localhost:9092
acks=all
retries=0
# Kafka-level compression must stay off; the only compression is the in-frame zlib
compression.type=none
# Glue Schema Registry configurations
schema.registry.type=glue
region=us-east-1
registry.name=test-registry
# Payload envelope encryption; presence of the key ARN is the enable switch
payload.envelope.encryption.provider.aws-kms.key.arn=arn:aws:kms:us-east-1:123456789012:key/abcd-1234
